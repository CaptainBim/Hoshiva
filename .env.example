# Hoshiva Server Configuration

# Server
PORT=3000
HOST=0.0.0.0

# Image Processing
FETCH_TIMEOUT=15000
MAX_OUTPUT_PX=12000

# Cache & Taxonomy
HOSHIVA_CACHE_DIR=data/cache
HOSHIVA_TAXONOMY_FILE=data/taxonomy.json

# Optional: waifu2x upscaler
# WAIFU2X_PATH=/path/to/waifu2x-ncnn-vulkan

# Server URL (untuk test API)
HOSHIVA_URL=https://your-deployed-url.railway.app
