# dependencies
node_modules/

# runtime state
# SELURUH isi data/ adalah state runtime, jadi abaikan foldernya, bukan
# per-file. Sebelumnya hanya data/cache/ dan data/taxonomy.json yang disebut,
# sehingga backup seperti data/taxonomy.backup-before-cap.json tetap ikut
# ter-commit. Server membuat foldernya sendiri saat boot
# (categories.js mkdirSync DATA_DIR, cache.js mkdirSync CACHE_DIR),
# jadi mengabaikan seluruh data/ tidak merusak repo baru.
data/

# sumber logo (berkas kerja, bukan aset yang disajikan lewat HTTP)
# Isi folder ini tidak di-commit demi menjaga repo tetap ringan.
src/

# env
.env
.env.*
!.env.example

# Railway CLI
# railway.json (Config as Code) sengaja ikut ter-commit: isinya hanya
# builder, start command, dan healthcheck, tidak ada credential.
# Folder .railway/ berbeda: itu state lokal CLI, menunjuk ke project dan
# environment spesifik. Milik tiap mesin, jadi jangan ikut ter-commit.
.railway/

# logs & OS junk
*.log
*.err
npm-debug.log*
Thumbs.db
.DS_Store

# editor
.vscode/
.idea/